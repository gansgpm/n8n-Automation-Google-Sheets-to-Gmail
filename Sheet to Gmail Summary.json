    {
      "parameters": {
        "jsCode": "// Build ONE summary email from all sheet rows\nconst esc = (v) => String(v ?? '').trim()\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// Keep only rows that actually contain something\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(r => esc(r.Name) || esc(r.Course) || esc(r.Status));\n\n// Empty sheet → tell the If node not to send anything\nif (rows.length === 0) {\n  return [{ json: { hasData: false } }];\n}\n\nconst today = $now.setZone('Asia/Kolkata').toFormat('dd LLL yyyy');\n\n// Count learners per status, e.g. Completed: 2 · In Progress: 2\nconst counts = {};\nfor (const r of rows) {\n  const s = esc(r.Status) || 'Not set';\n  counts[s] = (counts[s] || 0) + 1;\n}\nconst statusLine = Object.entries(counts)\n  .map(([s, n]) => `${s}: <b>${n}</b>`)\n  .join(' &nbsp;·&nbsp; ');\n\nconst cell = 'padding:8px 12px;border:1px solid #ddd;';\nconst tableRows = rows.map((r, i) => `\n  <tr>\n    <td style=\"${cell}\">${i + 1}</td>\n    <td style=\"${cell}\">${esc(r.Name) || '-'}</td>\n    <td style=\"${cell}\">${esc(r.Course) || '-'}</td>\n    <td style=\"${cell}\">${esc(r.Status) || '-'}</td>\n  </tr>`).join('');\n\nconst body = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222;\">\n  <p>Hi,</p>\n  <p>Here is the latest data from the Course Tracker sheet (${today}).</p>\n  <p><b>Total learners:</b> ${rows.length}<br>${statusLine}</p>\n  <table style=\"border-collapse:collapse;\">\n    <tr style=\"background:#f2f2f2;\">\n      <th style=\"${cell}\">#</th><th style=\"${cell}\">Name</th>\n      <th style=\"${cell}\">Course</th><th style=\"${cell}\">Status</th>\n    </tr>\n    ${tableRows}\n  </table>\n  <p>Regards,<br>Your Automation Bot</p>\n</div>`;\n\nreturn [{\n  json: {\n    hasData: true,\n    subject: `Course Status Summary – ${rows.length} learners – ${today}`,\n    body\n  }\n}];"
      },
